# =====================================================================
#  Mr Black Barbería — variables de entorno
#  Copia este archivo a `.env` y reemplaza TODOS los valores "cambiar".
#  Genera secretos con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#  Nunca subas el archivo .env al repositorio.
# =====================================================================

ENVIRONMENT=development
DEBUG=false

# ---------- PostgreSQL ----------
# Desarrollo: PostgreSQL de Docker (servicio "db"). Producción: Neon → ver .env.production.example
POSTGRES_DB=mrblack
POSTGRES_USER=mrblack
POSTGRES_PASSWORD=cambiar-password-postgres
DATABASE_URL=postgresql+psycopg://mrblack:cambiar-password-postgres@db:5432/mrblack
# Base de datos usada por pytest (se crea automáticamente en el contenedor db)
TEST_DATABASE_URL=postgresql+psycopg://mrblack:cambiar-password-postgres@db:5432/mrblack_test

# ---------- Seguridad (mínimo 32 caracteres cada uno) ----------
SECRET_KEY=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_SECRET=cambiar-por-otro-secreto-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_EXPIRE_MINUTES=30
# true en producción (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Solo si el frontend se sirve desde otro dominio (separados por coma)
CORS_ORIGINS=

# ---------- Aplicación ----------
FRONTEND_URL=http://localhost:8080
APP_TIMEZONE=America/Lima
# Carga datos de desarrollo al iniciar (usuarios, barberos, servicios, productos)
SEED_ON_START=true
# Contraseña inicial de los usuarios de desarrollo creados por el seed
SEED_DEFAULT_PASSWORD=MrBlack.Dev-2026

# ---------- Capacidad ----------
# Procesos de la API (uvicorn) y conexiones a PostgreSQL por proceso.
# Conexiones totales = WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW): menor al límite de la BD.
WEB_CONCURRENCY=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
# Hashes de contraseña simultáneos por proceso (~19 MB y un núcleo cada uno)
PASSWORD_HASH_CONCURRENCY=2

# ---------- Correo (SMTP) ----------
# smtp | console | google_script   (console solo escribe los correos en el log)
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM=Mr Black Barbería <no-reply@mrblack.pe>
# Bandeja que recibe un aviso por cada cita nueva (vacío: sin aviso)
NOTIFY_EMAIL=
# EMAIL_BACKEND=google_script: URL /exec de la aplicación web de Google Apps Script y su token
# (para hostings que bloquean SMTP, p. ej. Railway). Ver README → Correo.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_TOKEN=

# ---------- Recordatorio antes de la cita ----------
# Correo al cliente + aviso en la campana (cliente y barbero) REMINDER_MINUTES antes de la cita.
REMINDERS_ENABLED=false
REMINDER_MINUTES=10

# ---------- Google Calendar (opcional) ----------
# Crear credenciales OAuth 2.0 (Aplicación web) en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
