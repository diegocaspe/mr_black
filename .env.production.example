# =====================================================================
#  Mr Black Barbería — PRODUCCIÓN (PostgreSQL en Neon)
#  Copia este archivo a `.env.production` (ignorado por git) y completa los valores.
#  En el proveedor de hosting define estas mismas variables en su panel de entorno.
#  Para operar contra Neon desde tu equipo:  ENV_FILE=../.env.production  (ver README)
#  Nunca subas el archivo .env.production al repositorio.
# =====================================================================

ENVIRONMENT=production
DEBUG=false

# ---------- PostgreSQL (Neon) ----------
# Neon → Connect → base "mrblack" → conexión directa (sin pooling). Se puede pegar tal cual
# (postgresql://...?sslmode=require&channel_binding=require); la app usa el driver psycopg 3.
DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/mrblack?sslmode=require&channel_binding=require
# Opcional: base Neon exclusiva para pytest (se BORRA en cada ejecución). Debe contener "test".
TEST_DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/mrblack_test?sslmode=require&channel_binding=require

# ---------- Seguridad (secretos distintos a los de desarrollo, mínimo 32 caracteres) ----------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar
JWT_SECRET=cambiar
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_EXPIRE_MINUTES=30
# Obligatorio en producción (la app no arranca con false)
COOKIE_SECURE=true
COOKIE_DOMAIN=
# Vacío si el frontend y la API comparten dominio (nginx). Si no: https://mi-dominio.pe
CORS_ORIGINS=

# ---------- Aplicación ----------
FRONTEND_URL=https://mi-dominio.pe
APP_TIMEZONE=America/Lima
# Obligatorio en producción (la app no arranca con true)
SEED_ON_START=false

# ---------- Capacidad ----------
# Procesos de la API (uvicorn) y conexiones a PostgreSQL por proceso.
# Conexiones totales = WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW): menor al límite de la BD.
WEB_CONCURRENCY=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
# Hashes de contraseña simultáneos por proceso (~19 MB y un núcleo cada uno)
PASSWORD_HASH_CONCURRENCY=2

# ---------- Correo (SMTP real) ----------
EMAIL_BACKEND=smtp
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=la cuenta y SMTP_PASSWORD una contraseña de aplicación
# de 16 letras (myaccount.google.com/apppasswords, requiere verificación en 2 pasos). La contraseña
# normal de la cuenta no sirve. SMTP_FROM debe usar la misma cuenta o Gmail la reemplaza.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=Mr Black Barbería <no-reply@mrblack.pe>
# Bandeja que recibe un aviso por cada cita nueva (vacío: sin aviso)
NOTIFY_EMAIL=

# ---------- Google Calendar (opcional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mi-dominio.pe/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
